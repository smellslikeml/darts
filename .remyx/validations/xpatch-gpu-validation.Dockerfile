# The environment this validation was measured in, committed by Remyx
# for review. It is a GUESS about your project, assembled from what the
# repo declares.
#
# Edit it. The next validation builds from THIS file instead of
# generating one, so a correction here is permanent — a missing apt
# package or a pinned CUDA version costs one line rather than another
# failed run.
#
# run: 989d2f66    generated by: existing_in_repo
# device guard: pinned pip to cu126
# device guard: froze the base's torch before any later install
# device guard: base python:3.12-slim -> pytorch/pytorch:2.14.0-cuda12.6-cudnn9-runtime (gpu workload, torch in deps)
#
# Remove `.remyx/validations/` from the repo to go back to a
# generated environment, or set `commit_env: false` on the suite.
# ─────────────────────────────────────────────────────────────────
# Use a specific Python version for better reproducibility
FROM pytorch/pytorch:2.14.0-cuda12.6-cudnn9-runtime
# Pin the torch the base already ships so nothing installed later replaces it.
# `pip freeze | grep` rather than a heredoc: heredoc RUN is BuildKit syntax and
# this Dockerfile is built by kaniko, so a single line is the portable form.
# No torch in the base leaves the file empty, which is a harmless no-op.
RUN (pip freeze 2>/dev/null | grep -iE "^torch==" > /opt/remyx-pip-constraints.txt) || true; \
    echo "[remyx] torch pin: $(cat /opt/remyx-pip-constraints.txt 2>/dev/null || echo none)"
ENV PIP_CONSTRAINT=/opt/remyx-pip-constraints.txt
# pytorch/pytorch marks its python EXTERNALLY-MANAGED (PEP 668), so a plain
# `pip install -e .` — which every generated Dockerfile does — fails with
# `error: externally-managed-environment`. Verified against the real image:
# without this, every GPU build dies before the repo is installed. A container
# IS the isolation a venv would provide, so this is the right trade.
ENV PIP_BREAK_SYSTEM_PACKAGES=1
# Install into the user site, which is a `site-packages` directory. On this
# base the system python puts packages under dist-packages, and tooling that
# asks "is this module an installed package?" by looking for `site-packages`
# in its path (peft's harness does, before running `git rev-parse` in the
# module's directory) concludes it is a checkout and fails — on peft#10 that
# ended a 53-minute run one line before its result document was written. A
# venv would do the same job but needs `ensurepip`, which these images lack.
ENV PIP_USER=1
ENV PATH=/root/.local/bin:$PATH
# The base image's own packages (torch, on the pytorch images) live in
# dist-packages and cannot be reinstalled. Expose that directory under a
# site-packages alias and search it first, so the same "installed package?"
# test passes for them too. usercustomize (not sitecustomize: Debian's python
# ships a sitecustomize in the stdlib dir, which would win) runs before any
# user code and prepends the alias.
RUN python -c "import os, site, sysconfig; d = sysconfig.get_paths()['purelib']; s = d.replace('dist-packages', 'site-packages'); (d == s or os.path.lexists(s)) or os.symlink(d, s); u = site.getusersitepackages(); os.makedirs(u, exist_ok=True); open(os.path.join(u, 'usercustomize.py'), 'w').write('import sys\nsys.path.insert(0, %r)\n' % s); print('[remyx] site-packages alias:', s)" || true
ENV PIP_EXTRA_INDEX_URL="https://download.pytorch.org/whl/cu126"

# Set work directory
WORKDIR /app

# Install uv from official Astral source
# Using the standalone installer for reliability
COPY --from=ghcr.io/astral-sh/uv:0.11.7 /uv /usr/local/bin/uv

# Copy source code
COPY darts/ /app/darts/
# Copy only the files explicitly needed for installation
COPY pyproject.toml README.md /app/

# Install dependencies using uv
# --no-dev would install only core dependencies, but we want dev-all for the full environment
RUN uv sync --group dev-all

# Copy examples
COPY examples/ /app/examples/

# Set Python path so imports work correctly
ENV PATH="/app/.venv/bin:$PATH"

# Build and run instructions:
# docker build . -t darts:latest
# docker run -it -v $(pwd)/:/app/ darts:latest bash
#
# For Jupyter:
# docker run -it -p 8888:8888 darts:latest bash
# Then inside: uv run jupyter lab --ip 0.0.0.0 --no-browser --allow-root

# ── Remyx lighteval harness layer (appended by eval_env_builder) ──
# build_id: 0243aefd-da2b-4429-8a3f-0cf6504e2a52
# template: validation@v0
# eval_contract: v1
USER root
ARG GITHUB_TOKEN=""
# git is not a given: a runtime stage installs only what it needs to run.
RUN command -v git >/dev/null 2>&1 || \
    (apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*) || \
    apk add --no-cache git || true
RUN if [ ! -d /workspace/target_repo/.git ]; then \
      mkdir -p /workspace && \
      (git clone --depth=1 "https://x-access-token:${GITHUB_TOKEN}@github.com/smellslikeml/darts" /workspace/target_repo 2>/dev/null || \
       git clone --depth=1 "https://github.com/smellslikeml/darts" /workspace/target_repo || true) ; \
    fi

# Checkout the variant's specific commit.
RUN cd /workspace/target_repo && \
    git fetch --depth=1 origin b1df150d69bdd438be199c3ba6a2d64d00e27ec8 2>/dev/null && \
    git checkout b1df150d69bdd438be199c3ba6a2d64d00e27ec8 2>/dev/null || \
    echo "Note: checkout b1df150d69bd failed, using default branch"

# Overlay the eval harness from the feature branch (harness = eval definition,
# not code-under-test) so baseline + feature run the same eval.
RUN cd /workspace/target_repo && \
    git fetch --depth=1 origin 45e19ec9ed1aec54721823edef9c5972025da3c2 2>/dev/null || true ; \
    git checkout 45e19ec9ed1aec54721823edef9c5972025da3c2 -- "eval/eval_xpatch_gpu_validation.ipynb" 2>/dev/null || true ; \
    git checkout 45e19ec9ed1aec54721823edef9c5972025da3c2 -- "eval/" 2>/dev/null || true ; \
    ([ ! -d eval ] && git checkout 45e19ec9ed1aec54721823edef9c5972025da3c2 -- eval/ 2>/dev/null || true) ; \
    ([ ! -d tests ] && git checkout 45e19ec9ed1aec54721823edef9c5972025da3c2 -- tests/ 2>/dev/null || true) || true


# Pin transformers to avoid 5.x (broken on paper images with older torch)
RUN pip install --no-cache-dir "transformers>=4.41.0,<5.0" 2>/dev/null || true

RUN pip install --no-cache-dir \
        datasets \
        huggingface_hub

# Dependencies the suite declares alongside itself, which the repo-root install
# does not cover.
RUN cd /workspace/target_repo 2>/dev/null || cd /app 2>/dev/null || true; \
    if [ -f "eval/requirements.txt" ]; then \
      pip install --no-cache-dir -r "eval/requirements.txt" || true ; \
    else echo "[remyx] no eval/requirements.txt"; fi
# Added by the validation loop after a missing-dependency triage.
RUN pip install --no-cache-dir torch pytorch-lightning
# Notebook suite: execution is papermill in this pod. No hosted notebook
# service is in the execution path.
RUN pip install --no-cache-dir papermill nbclient nbformat ipykernel
ENV REMYX_NOTEBOOK_PARAMS="{}"

ENV TEST_SCRIPT_PATH="eval/eval_xpatch_gpu_validation.ipynb"
RUN mkdir -p /eval && echo "" | base64 -d > /eval/lighteval_runner.py && chmod +x /eval/lighteval_runner.py
ENTRYPOINT ["python", "/eval/lighteval_runner.py"]
